#!/bin/bash

if [ $# -ne 1 ]; then
    echo "Kasutus: $0 <kasutajad_parooliga_fail>"
    exit 1
fi

FAIL=$1

while IFS=: read -r KASUTAJA PAROOL || [ -n "$KASUTAJA" ]; do
    if [ -n "$KASUTAJA" ] && [ -n "$PAROOL" ]; then
        useradd -m "$KASUTAJA"
        echo "$KASUTAJA:$PAROOL" | chpasswd
    fi
done < "$FAIL"
